---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SECTIONS, type Section } from '../../site';

export async function getStaticPaths() {
  const paths = [];
  for (const section of Object.keys(SECTIONS) as Section[]) {
    for (const entry of await getCollection(section, ({ data }) => !data.draft)) {
      paths.push({
        params: { collection: section, slug: entry.id.replace(/\/index$/, '') },
        props: { entry },
      });
    }
  }
  return paths;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article>
    <h1>{entry.data.title}</h1>
    <p class="date">{entry.data.date.toISOString().slice(0, 10)}</p>
    <Content />
  </article>
</Base>
